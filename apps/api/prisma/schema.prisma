generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  guard
  employee
  reception
  security
  admin
}

enum VisitStatus {
  INVITED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  EXPIRED
}

enum VisitType {
  PRE
  WALKIN
  SELF
}

enum OutboxChannel {
  PUSH
  SMS
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

enum PremisesCategory {
  business
  events
  exhibition
}

model Plan {
  id            String     @id @default(uuid()) @db.Uuid
  code          String     @unique
  name          String
  features      String[]
  visitLimit    Int?       @map("visit_limit")
  premisesLimit Int?       @map("premises_limit")
  memberLimit   Int?       @map("member_limit")
  createdAt     DateTime   @default(now()) @map("created_at")
  businesses    Business[]

  @@map("plans")
}

model Business {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  logoKey     String?      @map("logo_key")
  planId      String       @map("plan_id") @db.Uuid
  otpLogin    Boolean      @default(true) @map("otp_login")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  plan        Plan         @relation(fields: [planId], references: [id])
  premises    Premises[]
  users       User[]
  departments Department[]
  visitors    Visitor[]
  visits      Visit[]

  @@map("businesses")
}

model Premises {
  id         String           @id @default(uuid()) @db.Uuid
  businessId String           @map("business_id") @db.Uuid
  name       String
  code       String           @unique
  webSlug    String           @map("web_slug")
  address    String?
  mobile     String?
  email      String?
  lat        Float?
  lng        Float?
  geofenceM  Int?             @map("geofence_m")
  category   PremisesCategory @default(business)
  isDefault  Boolean          @default(false) @map("is_default")
  purposes   String[]         @default(["Enquiry", "Casual Meet", "Appointment", "Meeting", "Visitor"])
  timezone   String           @default("Asia/Kolkata")
  createdAt  DateTime         @default(now()) @map("created_at")
  business   Business         @relation(fields: [businessId], references: [id])
  setting    PremisesSetting?
  gates      Gate[]
  members    UserPremises[]
  visits     Visit[]

  @@unique([businessId, webSlug])
  @@index([businessId])
  @@map("premises")
}

model PremisesSetting {
  premisesId        String   @id @map("premises_id") @db.Uuid
  businessId        String   @map("business_id") @db.Uuid
  visitStart        String?  @map("visit_start")
  visitEnd          String?  @map("visit_end")
  checkinOnApproval Boolean  @default(true) @map("checkin_on_approval")
  onlyCheckin       Boolean  @default(false) @map("only_checkin")
  autoCheckoutHrs   Int?     @map("auto_checkout_hrs")
  overstayMin       Int?     @map("overstay_min")
  waitingMin        Int?     @map("waiting_min")
  defaultVisitMin   Int      @default(240) @map("default_visit_min")
  slotMin           Int      @default(30) @map("slot_min")
  delayAlertMin     Int?     @map("delay_alert_min")
  onlyMemberCheckin Boolean  @default(false) @map("only_member_checkin")
  reportEmails      String[] @default([]) @map("report_emails")
  reportSchedule    String?  @map("report_schedule")
  googleReviewUrl   String?  @map("google_review_url")
  exitPlanKey       String?  @map("exit_plan_key")
  premises          Premises @relation(fields: [premisesId], references: [id], onDelete: Cascade)

  @@map("premises_settings")
}

model Department {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  business     Business      @relation(fields: [businessId], references: [id])
  users        User[]
  designations Designation[]

  @@unique([businessId, name])
  @@map("departments")
}

/// Job titles offered for one department (e.g. MIS: Executive, Manager). Members keep the chosen name.
model Designation {
  id           String     @id @default(uuid()) @db.Uuid
  businessId   String     @map("business_id") @db.Uuid
  departmentId String     @map("department_id") @db.Uuid
  name         String
  createdAt    DateTime   @default(now()) @map("created_at")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, name])
  @@index([businessId])
  @@map("designations")
}

model UserPremises {
  userId     String   @map("user_id") @db.Uuid
  premisesId String   @map("premises_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  premises   Premises @relation(fields: [premisesId], references: [id], onDelete: Cascade)

  @@id([userId, premisesId])
  @@index([premisesId])
  @@map("user_premises")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String?  @map("business_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  entity     String
  entityId   String   @map("entity_id")
  action     String
  before     Json?
  after      Json?
  at         DateTime @default(now())

  @@index([businessId, entity, entityId])
  @@map("audit_logs")
}

model Gate {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  premisesId String   @map("premises_id") @db.Uuid
  name       String
  isActive   Boolean  @default(true) @map("is_active")
  premises   Premises @relation(fields: [premisesId], references: [id])
  devices    Device[]
  visitsIn   Visit[]  @relation("InGate")
  visitsOut  Visit[]  @relation("OutGate")

  @@map("gates")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String?   @map("business_id") @db.Uuid
  name         String
  phone        String
  email        String?
  role         Role
  departmentId String?   @map("department_id") @db.Uuid
  designation  String?
  joiningDate  DateTime? @map("joining_date")
  isHost       Boolean   @default(true) @map("is_host")
  passwordHash String?   @map("password_hash")
  delegateId   String?   @map("delegate_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  /// Module access ticked by the admin, inside what the role allows. Empty = everything the role allows.
  modules      String[]  @default([])
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  business      Business?      @relation(fields: [businessId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id])
  premises      UserPremises[]
  delegate      User?          @relation("Delegate", fields: [delegateId], references: [id])
  delegators    User[]         @relation("Delegate")
  hostedVisits  Visit[]
  devices       Device[]
  refreshTokens RefreshToken[]

  @@unique([businessId, phone])
  @@unique([businessId, email])
  @@map("users")
}

model Visitor {
  id             String    @id @default(uuid()) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  phone          String
  name           String
  company        String?
  photoKey       String?   @map("photo_key")
  idType         String?   @map("id_type")
  idLast4        String?   @map("id_last4")
  consentAt      DateTime? @map("consent_at")
  consentVersion String?   @map("consent_version")
  deleteAfter    DateTime? @map("delete_after")
  createdAt      DateTime  @default(now()) @map("created_at")
  business       Business  @relation(fields: [businessId], references: [id])
  visits         Visit[]

  @@unique([businessId, phone])
  @@map("visitors")
}

model Visit {
  id                       String      @id @default(uuid()) @db.Uuid
  code                     String      @unique
  visitorId                String      @map("visitor_id") @db.Uuid
  hostId                   String      @map("host_id") @db.Uuid
  businessId               String      @map("business_id") @db.Uuid
  premisesId               String      @map("premises_id") @db.Uuid
  groupId                  String?     @map("group_id") @db.Uuid
  type                     VisitType
  purpose                  String
  invitedName              String?     @map("invited_name")
  status                   VisitStatus
  validFrom                DateTime    @map("valid_from")
  validTo                  DateTime    @map("valid_to")
  inGateId                 String?     @map("in_gate_id") @db.Uuid
  outGateId                String?     @map("out_gate_id") @db.Uuid
  checkedInAt              DateTime?   @map("checked_in_at")
  checkedOutAt             DateTime?   @map("checked_out_at")
  vehicleNo                String?     @map("vehicle_no")
  inviteTokenHash          String?     @unique @map("invite_token_hash")
  receptionCallRequestedAt DateTime?   @map("reception_call_requested_at")
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")

  visitor  Visitor      @relation(fields: [visitorId], references: [id])
  host     User         @relation(fields: [hostId], references: [id])
  business Business     @relation(fields: [businessId], references: [id])
  premises Premises     @relation(fields: [premisesId], references: [id])
  inGate   Gate?        @relation("InGate", fields: [inGateId], references: [id])
  outGate  Gate?        @relation("OutGate", fields: [outGateId], references: [id])
  events   VisitEvent[]
  outbox   Outbox[]

  @@index([premisesId, status])
  @@index([businessId, createdAt])
  @@index([hostId, validFrom])
  @@map("visits")
}

model VisitEvent {
  id            String   @id @default(uuid()) @db.Uuid
  visitId       String   @map("visit_id") @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  type          String
  actorId       String?  @map("actor_id") @db.Uuid
  gateId        String?  @map("gate_id") @db.Uuid
  deviceId      String?  @map("device_id") @db.Uuid
  clientEventId String?  @unique @map("client_event_id")
  occurredAt    DateTime @default(now()) @map("occurred_at")
  receivedAt    DateTime @default(now()) @map("received_at")
  meta          Json?

  visit Visit @relation(fields: [visitId], references: [id])

  @@index([visitId, occurredAt])
  @@map("visit_events")
}

model Outbox {
  id            String        @id @default(uuid()) @db.Uuid
  visitId       String?       @map("visit_id") @db.Uuid
  businessId    String?       @map("business_id") @db.Uuid
  channel       OutboxChannel
  template      String
  recipient     String
  vars          Json
  status        OutboxStatus  @default(PENDING)
  attempts      Int           @default(0)
  nextRetryAt   DateTime      @default(now()) @map("next_retry_at")
  providerMsgId String?       @map("provider_msg_id")
  lastError     String?       @map("last_error")
  createdAt     DateTime      @default(now()) @map("created_at")

  visit Visit? @relation(fields: [visitId], references: [id])

  @@index([status, nextRetryAt])
  @@map("outbox")
}

model Device {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  gateId        String?        @map("gate_id") @db.Uuid
  name          String
  pushToken     String?        @map("push_token")
  lastSeenAt    DateTime?      @map("last_seen_at")
  revokedAt     DateTime?      @map("revoked_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  user          User           @relation(fields: [userId], references: [id])
  gate          Gate?          @relation(fields: [gateId], references: [id])
  refreshTokens RefreshToken[]

  @@map("devices")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  deviceId  String    @map("device_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id])
  device    Device    @relation(fields: [deviceId], references: [id])

  @@map("refresh_tokens")
}
