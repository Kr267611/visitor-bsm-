{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testRegex": "\\.e2e\\.ts$",
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "setupFiles": ["<rootDir>/test/env.ts"],
  "moduleNameMapper": { "^@visitor/shared$": "<rootDir>/../../packages/shared/src" },
  "testTimeout": 20000
}
